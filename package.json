{
  "name": "cloudcode-link-core",
  "version": "0.1.0",
  "description": "Headless core library for Google Cloud Code / Antigravity multi-account pool, auth, and protocol converters",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "undici": "^6.21.1 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WinterSold1er/cloudcode-link-core.git"
  },
  "bugs": {
    "url": "https://github.com/WinterSold1er/cloudcode-link-core/issues"
  },
  "homepage": "https://github.com/WinterSold1er/cloudcode-link-core#readme"
